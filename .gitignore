# notes perso
docs/

# Bundle flutter-pi extrait du build Docker
dist/

# Plateforme macOS : sert uniquement au dev/test local sur Mac.
# Gardée sur le disque, flutter run -d macos marche, mais non versionnée.
# La cible de prod est Linux arm64 ; macos/ est régénérable via flutter create.
macos/

# Plateforme web : sert uniquement au preview local, flutter run -d web-server.
# Non versionnée ; régénérable via flutter create --platforms=web .
web/

