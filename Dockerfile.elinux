# syntax=docker/dockerfile:1
#
# Build de kioskdiag avec flutter-elinux (Sony / flutter-embedded-linux),
# backend WAYLAND natif — PAS GTK3.
#
# Pourquoi : sur cette carte (Mali g24p0, weston), l'embedder Flutter GTK3 rend
# bien en GLES (Mali-G52, OpenGL ES 3.2) mais NE PRÉSENTE PAS sa frame sous
# Wayland (gdk_cairo_draw_from_gl ne commit aucun buffer). Prouvé par un
# GtkGLArea pur (écran noir alors que le rendu se fait). Le backend Wayland de
# flutter-elinux est un client wl_egl_window BRUT (comme weston-simple-egl, qui
# affiche son triangle hardware sur ce Mali) -> il présente. Même code Dart.
#
# Build + extraction dans ./dist-elinux :
#   docker build -f Dockerfile.elinux --target export --output type=local,dest=dist-elinux .
#   # le bundle tourne ensuite en client de weston (cf. deploy/run-weston.sh, à
#   # adapter : plus de GDK_*, on lance le binaire elinux avec --bundle).

# ============================ Build ============================
FROM ubuntu:24.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive

# Deps de build : toolchain + dev Wayland/EGL/GLES/xkbcommon (le backend wayland
# de flutter-elinux linke là-dessus ; les .so runtime Mali sont sur la carte).
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git unzip xz-utils zip ca-certificates \
    build-essential clang cmake ninja-build pkg-config \
    libwayland-dev wayland-protocols libxkbcommon-dev \
    libegl1-mesa-dev libgles2-mesa-dev liblzma-dev libstdc++-13-dev \
    libfontconfig1-dev \
    && rm -rf /var/lib/apt/lists/*

# flutter-elinux embarque son propre SDK Flutter (fork). Épinglé sur un SHA
# précis pour un build reproductible (avant : --depth 1 sur la branche par
# défaut, donc un commit différent à chaque reclone possible, silencieusement).
# SHA = HEAD réel de sony/flutter-elinux relevé le 2026-07-07 via
# `git ls-remote https://github.com/sony/flutter-elinux.git HEAD` — build
# Docker complet non ré-exécuté pour confirmer qu'il compile avec ce SHA
# précis (voir limite assumée du Lot D). Pour bumper : choisir un nouveau
# SHA, relancer le build complet (`docker build -f Dockerfile.elinux
# --target export --output type=local,dest=dist-elinux .`) et confirmer
# qu'il passe avant de remplacer la valeur ci-dessous.
ARG FLUTTER_ELINUX_SHA=cdc9622651ee7b217697258cd5ca0b8963f1d6a4
RUN git clone https://github.com/sony/flutter-elinux.git /opt/flutter-elinux \
    && git -C /opt/flutter-elinux checkout "$FLUTTER_ELINUX_SHA"
ENV PATH="/opt/flutter-elinux/bin:${PATH}"
RUN git config --global --add safe.directory /opt/flutter-elinux \
    && flutter-elinux --version

WORKDIR /app

# Dépendances d'abord (cache).
COPY pubspec.yaml pubspec.lock ./
RUN flutter-elinux pub get

# Le reste du code.
COPY . .

# Scaffold du runner eLinux (génère elinux/ si absent) puis build Wayland arm64.
RUN [ -d elinux ] || flutter-elinux create --platforms=elinux .
# KIOSKDIAG_VERSION : source unique = `version:` de pubspec.yaml, injectée au
# build pour un futur diagnostic (traçabilité du binaire déployé). Non lue
# par l'UI aujourd'hui (le footer affiche la date Puppet depuis le Lot F1) —
# c'est une infrastructure prête pour un usage diagnostic futur.
RUN flutter-elinux build elinux --target-arch=arm64 --target-backend-type=wayland --release \
    --dart-define=KIOSKDIAG_VERSION=$(grep '^version:' pubspec.yaml | cut -d' ' -f2)

# Bundle dans build/elinux/<arch>/release/bundle/
RUN mkdir -p /out && cp -a build/elinux/*/release/bundle/. /out/

# ============================ Export ============================
FROM scratch AS export
COPY --from=builder /out/ /
